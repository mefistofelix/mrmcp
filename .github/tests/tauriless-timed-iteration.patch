diff --git a/tauriless/timed_iteration.rs b/tauriless/timed_iteration.rs
new file mode 100644
index 0000000..c19be83
--- /dev/null
+++ b/tauriless/timed_iteration.rs
@@ -0,0 +1,70 @@
+use std::{sync::{Arc, Mutex}, time::{Duration, Instant}};
+
+use tauri::EventLoopMessage;
+use tauri_runtime_wry::{
+    tao::{
+        event::{Event, StartCause},
+        event_loop::{ControlFlow, EventLoopProxy as TaoEventLoopProxy, EventLoopWindowTarget},
+    },
+    Context, EventLoopIterationContext, Message, Plugin, PluginBuilder, WebContextStore,
+};
+
+pub type Deadline = Arc<Mutex<Option<Instant>>>;
+
+pub fn new_deadline() -> Deadline {
+    Arc::new(Mutex::new(None))
+}
+
+pub fn arm(deadline: &Deadline, millis: u64) {
+    *deadline.lock().expect("timed iteration mutex poisoned") =
+        Some(Instant::now() + Duration::from_millis(millis));
+}
+
+pub fn clear(deadline: &Deadline) {
+    *deadline.lock().expect("timed iteration mutex poisoned") = None;
+}
+
+pub struct Builder(pub Deadline);
+pub struct TimedIteration {
+    deadline: Deadline,
+}
+
+impl PluginBuilder<EventLoopMessage> for Builder {
+    type Plugin = TimedIteration;
+
+    fn build(self, _context: Context<EventLoopMessage>) -> Self::Plugin {
+        TimedIteration { deadline: self.0 }
+    }
+}
+
+impl Plugin<EventLoopMessage> for TimedIteration {
+    fn on_event(
+        &mut self,
+        event: &Event<Message<EventLoopMessage>>,
+        _event_loop: &EventLoopWindowTarget<Message<EventLoopMessage>>,
+        _proxy: &TaoEventLoopProxy<Message<EventLoopMessage>>,
+        control_flow: &mut ControlFlow,
+        _context: EventLoopIterationContext<'_, EventLoopMessage>,
+        _web_context: &WebContextStore,
+    ) -> bool {
+        let Some(deadline) = *self.deadline.lock().expect("timed iteration mutex poisoned") else {
+            return false;
+        };
+
+        match event {
+            Event::MainEventsCleared | Event::RedrawEventsCleared => {
+                *control_flow = if Instant::now() >= deadline {
+                    ControlFlow::Exit
+                } else {
+                    ControlFlow::WaitUntil(deadline)
+                };
+                true
+            }
+            Event::NewEvents(StartCause::ResumeTimeReached { .. }) => {
+                *control_flow = ControlFlow::Exit;
+                true
+            }
+            _ => false,
+        }
+    }
+}
